APP_ENV=development
HTTP_ADDR=:8080
POSTGRES_DB=vita
POSTGRES_USER=vita
POSTGRES_PASSWORD=
# Set DATABASE_URL when running Go tools outside Compose.
DATABASE_URL=postgres://vita:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/vita?sslmode=disable
# Generate a random secret of at least 32 bytes. No default secret is supplied.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
CORS_ORIGINS=http://localhost:3000
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_FACILITY_NAME=Synthetic Development Facility
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
AI_PROVIDER=mock
EXTERNAL_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_ATTEMPTS=2
